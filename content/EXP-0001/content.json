      }
    ],
    "captions": [
      {
        "start_frame": 0,
        "end_frame": 76,
        "text": "刷到不少AI漫剧副业内容，",
        "chapter": "01"
      },
      {
        "start_frame": 76,
        "end_frame": 129,
        "text": "我决定先不报班。",
        "chapter": "01"
      },
      {
        "start_frame": 129,
        "end_frame": 182,
        "text": "自己跑一遍：",
        "chapter": "01"
      },
      {
        "start_frame": 182,
        "end_frame": 235,
        "text": "要准备什么，",
        "chapter": "01"
      },
      {
        "start_frame": 235,
        "end_frame": 288,
        "text": "又会在哪里返工？",
        "chapter": "01"
      },
      {
        "start_frame": 288,
        "end_frame": 341,
        "text": "我先拆成四件事：",
        "chapter": "02"
      },
      {
        "start_frame": 341,
        "end_frame": 428,
        "text": "故事冲突、人物场景、生成工具，",
        "chapter": "02"
      },
      {
        "start_frame": 428,
        "end_frame": 481,
        "text": "还有预算和验收。",
        "chapter": "02"
      },
      {
        "start_frame": 481,
        "end_frame": 534,
        "text": "文字模型整理资料，",
        "chapter": "02"
      },
      {
        "start_frame": 534,
        "end_frame": 587,
        "text": "图像工具做参考，",
        "chapter": "02"
      },
      {
        "start_frame": 587,
        "end_frame": 639,
        "text": "视频模型生成镜头。",
        "chapter": "02"
      },
      {
        "start_frame": 639,
        "end_frame": 692,
        "text": "但每一步，",
        "chapter": "02"
      },
      {
        "start_frame": 692,
        "end_frame": 768,
        "text": "都要有人判断能不能往下走。",
        "chapter": "02"
      },
      {
        "start_frame": 768,
        "end_frame": 874,
        "text": "我基于LocalMiniDrama继续搭建工作台",
        "chapter": "03"
      },
      {
        "start_frame": 874,
        "end_frame": 914,
        "text": "，",
        "chapter": "03"
      },
      {
        "start_frame": 914,
        "end_frame": 985,
        "text": "把想法、角色、分镜和审核串起来。",
        "chapter": "03"
      },
      {
        "start_frame": 985,
        "end_frame": 1024,
        "text": "入口能变清楚，",
        "chapter": "03"
      },
      {
        "start_frame": 1024,
        "end_frame": 1064,
        "text": "但界面改好了，",
        "chapter": "03"
      },
      {
        "start_frame": 1064,
        "end_frame": 1104,
        "text": "画面也未必就对。",
        "chapter": "03"
      },
      {
        "start_frame": 1104,
        "end_frame": 1155,
        "text": "重制前，",
        "chapter": "04"
      },
      {
        "start_frame": 1155,
        "end_frame": 1245,
        "text": "古装押送兵竟然跑出了近现代军服。",
        "chapter": "04"
      },
      {
        "start_frame": 1245,
        "end_frame": 1296,
        "text": "查记录才发现，",
        "chapter": "04"
      },
      {
        "start_frame": 1296,
        "end_frame": 1415,
        "text": "润色后的提示词混进了立领、双排扣这些描述。",
        "chapter": "04"
      },
      {
        "start_frame": 1415,
        "end_frame": 1477,
        "text": "所以先校准时代和服制，",
        "chapter": "04"
      },
      {
        "start_frame": 1477,
        "end_frame": 1528,
        "text": "错误参考也要撤下，",
        "chapter": "04"
      },
      {
        "start_frame": 1528,
        "end_frame": 1584,
        "text": "不能直接接着做视频。",
        "chapter": "04"
      },
      {
        "start_frame": 1584,
        "end_frame": 1633,
        "text": "人物卡更新了，",
        "chapter": "05"
      },
      {
        "start_frame": 1633,
        "end_frame": 1709,
        "text": "分镜却还沿用旧衣服、旧描述。",
        "chapter": "05"
      },
      {
        "start_frame": 1709,
        "end_frame": 1759,
        "text": "这次的问题，",
        "chapter": "05"
      },
      {
        "start_frame": 1759,
        "end_frame": 1824,
        "text": "是上下游各存了一份资料，",
        "chapter": "05"
      },
      {
        "start_frame": 1824,
        "end_frame": 1873,
        "text": "改动没有传下去。",
        "chapter": "05"
      },
      {
        "start_frame": 1873,
        "end_frame": 1955,
        "text": "后来补上依赖同步和旧素材失效；",
        "chapter": "05"
      },
      {
        "start_frame": 1955,
        "end_frame": 2004,
        "text": "文字改了，",
        "chapter": "05"
      },
      {
        "start_frame": 2004,
        "end_frame": 2064,
        "text": "旧图也不能自动算合格。",
        "chapter": "05"
      },
      {
        "start_frame": 2064,
        "end_frame": 2123,
        "text": "同一张脸、同一套衣服，",
        "chapter": "06"
      },
      {
        "start_frame": 2123,
        "end_frame": 2172,
        "text": "还不够。",
        "chapter": "06"
      },
      {
        "start_frame": 2172,
        "end_frame": 2220,
        "text": "押送中的囚犯，",
        "chapter": "06"
      },
      {
        "start_frame": 2220,
        "end_frame": 2269,
        "text": "怎么会干干净净？",
        "chapter": "06"
      },
      {
        "start_frame": 2269,
        "end_frame": 2323,
        "text": "要补衣料磨损和脏痕，",
        "chapter": "06"
      },
      {
        "start_frame": 2323,
        "end_frame": 2430,
        "text": "还得逐人处理木枷、脚镣和官兵的行军状态。",
        "chapter": "06"
      },
      {
        "start_frame": 2430,
        "end_frame": 2495,
        "text": "重生图也会冒出巨型脚镣。",
        "chapter": "06"
      },
      {
        "start_frame": 2495,
        "end_frame": 2544,
        "text": "图片不对，",
        "chapter": "06"
      },
      {
        "start_frame": 2544,
        "end_frame": 2592,
        "text": "就先停在图片阶段。",
        "chapter": "06"
      },
      {
        "start_frame": 2592,
        "end_frame": 2646,
        "text": "到了动作，",
        "chapter": "07"
      },
      {
        "start_frame": 2646,
        "end_frame": 2712,
        "text": "取刀也没有稳定连起来。",
        "chapter": "07"
      },
      {
        "start_frame": 2712,
        "end_frame": 2784,
        "text": "这里是原片和剪辑版对照。",
        "chapter": "07"
      },
      {
        "start_frame": 2784,
        "end_frame": 2844,
        "text": "最后切到对方的反应，",
        "chapter": "07"
      },
      {
        "start_frame": 2844,
        "end_frame": 2898,
        "text": "再回到持刀结果，",
        "chapter": "07"
      },
      {
        "start_frame": 2898,
        "end_frame": 2952,
        "text": "用分切交代动作。",
        "chapter": "07"
      },
      {
        "start_frame": 2952,
        "end_frame": 3006,
        "text": "故事能往下讲了，",
        "chapter": "07"
      },
      {
        "start_frame": 3006,
        "end_frame": 3120,
        "text": "但这不等于模型完成了连续、准确的取刀。",
        "chapter": "07"
      },
      {
        "start_frame": 3120,
        "end_frame": 3164,
        "text": "成本也要重算范围：",
        "chapter": "08"
      },
      {
        "start_frame": 3164,
        "end_frame": 3207,
        "text": "搭工作台的测试，",
        "chapter": "08"
      },
      {
        "start_frame": 3207,
        "end_frame": 3251,
        "text": "重制前的角色问题，",
        "chapter": "08"
      },
      {
        "start_frame": 3251,
        "end_frame": 3300,
        "text": "以及图片、视频返工，",
        "chapter": "08"
      },
      {
        "start_frame": 3300,
        "end_frame": 3343,
        "text": "都该算。",
        "chapter": "08"
      },
      {
        "start_frame": 3343,
        "end_frame": 3397,
        "text": "光全员押送状态这一轮，",
        "chapter": "08"
      },
      {
        "start_frame": 3397,
        "end_frame": 3465,
        "text": "就记录了十八次图片工具调用，",
        "chapter": "08"
      },
      {
        "start_frame": 3465,
        "end_frame": 3509,
        "text": "金额仍未知。",
        "chapter": "08"
      },
      {
        "start_frame": 3509,
        "end_frame": 3552,
        "text": "现有快照里，",
        "chapter": "08"
      },
      {
        "start_frame": 3552,
        "end_frame": 3630,
        "text": "九月账户现金二百七十四点九二元，",
        "chapter": "08"
      },
      {
        "start_frame": 3630,
        "end_frame": 3674,
        "text": "包含两百元套餐；",
        "chapter": "08"
      },
      {
        "start_frame": 3674,
        "end_frame": 3747,
        "text": "九月二十八日是七十四点九二元。",
        "chapter": "08"
      },
      {
        "start_frame": 3747,
        "end_frame": 3790,
        "text": "两笔不能相加，",
        "chapter": "08"
      },
      {
        "start_frame": 3790,
        "end_frame": 3839,
        "text": "也都不是本集总成本。",
        "chapter": "08"
      },
      {
        "start_frame": 3839,
        "end_frame": 3936,
        "text": "文字、图片工具、人工和套餐分摊还没对齐。",
        "chapter": "08"
      },
      {
        "start_frame": 3936,
        "end_frame": 4042,
        "text": "现在留下的是六十秒、七百二十P检查版，",
        "chapter": "09"
      },
      {
        "start_frame": 4042,
        "end_frame": 4103,
        "text": "原声还没完成主观听审。",
        "chapter": "09"
      },
      {
        "start_frame": 4103,
        "end_frame": 4153,
        "text": "这次最大的收获，",
        "chapter": "09"
      },
      {
        "start_frame": 4153,
        "end_frame": 4220,
        "text": "是把错误拦在下一步之前。",
        "chapter": "09"
      },
      {
        "start_frame": 4220,
        "end_frame": 4270,
        "text": "接下来先听审，",
        "chapter": "09"
      },
      {
        "start_frame": 4270,
        "end_frame": 4320,
        "text": "再找观众验证。",
        "chapter": "09"
      }
    ],
